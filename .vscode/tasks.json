{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "command": "cmd",
            "type": "process",
            "args": [
                "/c",
                "${workspaceFolder}\\build_all.bat"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-release",
            "command": "cmd",
            "type": "process",
            "args": [
                "/c",
                "${workspaceFolder}\\build_all.bat",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-all",
            "command": "cmd",
            "type": "process",
            "args": [
                "/c",
                "${workspaceFolder}\\build_all.bat",
                "All"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
