<UserControl x:Class="WpfApp.Views.ScanResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="1440">
    <!-- STEP 2: FULL TABULAR DATAGRID FILE LIST VIEW -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Sub Header (Top Bar) -->
            <RowDefinition Height="*"/>    <!-- Split View (DataGrid + GridSplitter + Preview Panel) -->
            <RowDefinition Height="64"/>  <!-- Bottom Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Sub Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedDisk.VolumeLabel}" FontSize="14" FontWeight="Bold" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding ScanProgressText, StringFormat='- ({0})'}" FontSize="13" Foreground="#16A34A" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 재검색" Command="{Binding RefreshScanCommand}" Style="{StaticResource SecondaryBtn}"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DATAGRID FILE LIST -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Input Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="6" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="#0F172A" BorderThickness="0" 
                                     VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Count & Sorting Hint Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="{Binding DocumentBreakdownText}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="* 컬럼 헤더 클릭 시 오름차순(▲)/내림차순(▼) 정렬됩니다" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 9-COLUMN DATAGRID -->
                    <DataGrid x:Name="FileDataGrid" Grid.Row="2" ItemsSource="{Binding FilteredFileList}" SelectedItem="{Binding SelectedFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              Background="#FFFFFF" BorderThickness="1" BorderBrush="#E2E8F0" RowHeaderWidth="0" 
                              CanUserSortColumns="True" CanUserResizeColumns="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              RowHeight="38" Sorting="FileDataGrid_Sorting">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- 1. 번호 (Index - Non-sortable) -->
                            <DataGridTemplateColumn Header="번호" Width="60" CanUserSort="False" SortMemberPath="Index">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Index}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. 파일명 (FileName) -->
                            <DataGridTemplateColumn Header="파일명 ▲" Width="200" SortMemberPath="FileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. 크기 (FileSizeFormatted) -->
                            <DataGridTemplateColumn Header="크기" Width="95" SortMemberPath="FileSizeBytes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. 확장자 (Extension) -->
                            <DataGridTemplateColumn Header="확장자" Width="85" SortMemberPath="Extension">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Extension}" FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. 분석 결과 (Status - 경로 왼쪽 위치) -->
                            <DataGridTemplateColumn Header="분석 결과" Width="180" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" Background="{Binding StatusBadgeColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 6. 경로 (FilePath) -->
                            <DataGridTemplateColumn Header="경로" Width="280" SortMemberPath="FilePath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 7. 만든시간 (CreatedTimeFormatted) -->
                            <DataGridTemplateColumn Header="만든시간" Width="135" SortMemberPath="CreatedTime">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedTimeFormatted}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 8. 수정시간 (LastModifiedFormatted) -->
                            <DataGridTemplateColumn Header="수정시간" Width="135" SortMemberPath="LastModified">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModifiedFormatted}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 9. 본문 미리보기 (TextSnippet) -->
                            <DataGridTemplateColumn Header="본문 미리보기" Width="450" SortMemberPath="TextSnippet">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TextSnippet}" FontSize="11" Foreground="#3B82F6" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- EMPTY STATE OVERLAY (탐색 결과 없음) -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6"
                            Visibility="{Binding HasNoScanResult, Converter={StaticResource BoolToVisConverter}}"
                            Panel.ZIndex="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36"
                                    Background="#F0F7FF" BorderBrush="#BFDBFE" BorderThickness="2"
                                    HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="📭" FontSize="32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="탐색된 파일 없음"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#0F172A"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="이미지 파일에서 HWP / HWPX / PDF 문서를 찾을 수 없습니다."
                                       FontSize="13" Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <Border Background="#F0F7FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="대상: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDisk.VolumeLabel}" FontSize="12" FontWeight="Bold"
                                               Foreground="#2563EB" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDisk.DriveTypeStr, StringFormat='  ·  {0}'}"
                                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- INTERACTIVE GRID SPLITTER -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          Background="#F1F5F9" Foreground="#CBD5E1" Cursor="SizeWE" ShowsPreview="True">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="1,0">
                            <Border Width="2" Height="32" Background="#CBD5E1" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- RIGHT COLUMN: DOCUMENT PREVIEW PANEL -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header Metadata Card -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="17" FontWeight="Bold" Foreground="#3B82F6" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PreviewFilePath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="포맷 형식" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PreviewFormatType}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="파일 크기" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PreviewFileSize}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="수정 일시" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PreviewLastModified}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="텍스트 통계" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PreviewLineCount, StringFormat='{}{0:N0} 줄'}" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Row 1: Detection Findings Card (Visible if findings exist) -->
                    <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding SelectedFile.HasFindings, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedFile.FindingCountText}" FontSize="13" FontWeight="Bold" Foreground="#991B1B"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedFile.Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Background="{Binding BadgeColor}" VerticalAlignment="Top" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding BadgeText}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="📂 폴더 열기" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                        <Button Content="📄 파일 열기" Command="{Binding OpenFileCommand}" Style="{StaticResource DessFooterBtn}" Padding="14,4" Margin="0"/>
                    </StackPanel>

                    <!-- Row 3: Unified WebView2 Document Viewer Component -->
                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                        <Grid>
                            <!-- Unified WebView2 Document Viewer (PDF native & HWP/HWPX A4 Paper HTML) -->
                            <wv2:WebView2 x:Name="MainWebView"/>

                            <!-- Loading Indicator Overlay -->
                            <Border Background="#E0FFFFFF" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisConverter}}" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="160" Height="6" IsIndeterminate="True" Foreground="#3B82F6"/>
                                    <TextBlock Text="문서 미리보기 읽는 중..." FontSize="13" FontWeight="Bold" Foreground="#3B82F6" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM FOOTER BAR (STEP 2) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <!-- Bottom Left: "◀ 뒤로" Button -->
                <Button Content="뒤로" Command="{Binding GoToPreviousStepCommand}" 
                        Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" VerticalAlignment="Center" 
                        Margin="20,10,0,10" Padding="14,5"/>

                <!-- Bottom Right: Total file count summary label -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding FilteredFileList.Count, StringFormat='총 {0:N0}개 문서'}" FontSize="13" FontWeight="Bold" Foreground="#3B82F6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
