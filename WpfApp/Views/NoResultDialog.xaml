<Window x:Class="WpfApp.Views.NoResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSAT"
        Icon="../Resources/app_icon.png"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Malgun Gothic">

    <Border Background="#FFFFFF" CornerRadius="12"
            BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Color="#1E293B" Opacity="0.12"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 드래그 타이틀바 -->
                <RowDefinition Height="Auto"/>  <!-- 본문 -->
                <RowDefinition Height="Auto"/>  <!-- 구분선 + 버튼 -->
            </Grid.RowDefinitions>

            <!-- ① 드래그 가능한 타이틀바 -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    Padding="20,14" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="탐색 결과" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#334155"/>
                    </StackPanel>
                    <!-- 닫기 버튼 -->
                    <Button x:Name="CloseBtn" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28"
                            FontSize="11" Foreground="#64748B"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ② 본문 -->
            <StackPanel Grid.Row="1" Margin="32,28,32,24" HorizontalAlignment="Center">

                <!-- 아이콘 원 -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="📭" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 제목 -->
                <TextBlock x:Name="TitleText"
                           FontSize="17" FontWeight="Bold"
                           Foreground="#0F172A" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <!-- 설명 -->
                <TextBlock x:Name="SubText"
                           FontSize="13" Foreground="#475569"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,0,16" LineHeight="20"/>

                <!-- 대상 파일 배지 -->
                <Border x:Name="BadgeBorder"
                        Background="#F0F7FF" BorderBrush="#BFDBFE" BorderThickness="1"
                        CornerRadius="8" Padding="14,8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💿 " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileNameText"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1D4ED8" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                        <TextBlock x:Name="FsInfoText"
                                   FontSize="11" Foreground="#64748B"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ③ 하단 버튼 영역 -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    Padding="24,14" CornerRadius="0,0,12,12">
                <Button x:Name="OkBtn" Content="확인"
                        Width="96" Height="34"
                        HorizontalAlignment="Right"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="#FFFFFF" Cursor="Hand"
                        Click="OkBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                BorderBrush="#1D4ED8" BorderThickness="0,0,0,2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                                <Setter TargetName="Bd" Property="Margin" Value="0,2,0,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
