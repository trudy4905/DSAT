<Window x:Class="WpfApp.Views.ExportCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="내보내기 완료" Height="260" Width="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Window Header / Drag Bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="11,11,0,0" Padding="16,12" MouseDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="내보내기 완료" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" 
                            Cursor="Hand" Padding="4"/>
                </Grid>
            </Border>

            <!-- Content Body -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,16">
                <!-- Success Icon Circle -->
                <Border Width="48" Height="48" CornerRadius="24" Background="#ECFDF5" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Success Text -->
                <TextBlock x:Name="TxtSummary" Text="총 0개 파일 내보내기 성공" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtFolderPath" Text="C:\Users\...\Desktop" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,11,11" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenFolder" Content="📂 폴더 열기" Click="OpenFolder_Click" Style="{StaticResource DessFooterBtn}" Background="#10B981" BorderBrush="#059669" Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="닫기" Click="CloseButton_Click" Style="{StaticResource SecondaryBtn}" Padding="16,6" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
